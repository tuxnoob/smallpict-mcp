{
  "name": "@smallpict/mcp",
  "version": "0.0.2",
  "description": "Official Model Context Protocol (MCP) server for SmallPict Image Optimization",
  "type": "module",
  "bin": {
    "smallpict-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "smallpict",
    "image-optimization",
    "webp",
    "avif",
    "ai-agent"
  ],
  "author": "SmallPict Engineering <support@smallpict.app>",
  "license": "MIT",
  "homepage": "https://smallpict.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuxnoob/smallpict-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tuxnoob/smallpict-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@smallpict/sdk": "^0.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
